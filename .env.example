# Copia a `.env.local` y ajusta los valores. NUNCA commitees `.env.local`.
# EXPO_PUBLIC_* se expone al bundle de la app (no poner secretos aquí).
#
# API de campo del gestor (agent-core, pack-cobranza) — ADR-0065/0081:
#   EXPO_PUBLIC_API_URL = <host>/api/pack/pack_cobranza  (prefijo público del pack)
#
# El tenant YA NO se compila: el login unificado lo resuelve desde las credenciales
# y la app permite elegir negocio si el usuario pertenece a varios (ADR-0081).
EXPO_PUBLIC_API_URL=http://localhost:8000/api/pack/pack_cobranza

# Panel web para los enlaces que la app no tiene (fichas de agente, suscripciones).
# En producción suele ser el mismo host que la API; en local, el puerto del panel.
# EXPO_PUBLIC_PANEL_URL=http://192.168.1.10:3210
