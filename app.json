{
  "expo": {
    "name": "Solver",
    "slug": "app-cobranza-apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cobranzacobrador",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cobraia.cobrador"
    },
    "android": {
      "package": "com.cobraia.cobrador",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#172f6c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos como evidencia de gastos.",
          "cameraPermission": "La app usa la cámara para tomar evidencias de gastos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para registrar la trayectoria de la cartera."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#172f6c",
          "image": "./assets/logo-transparente.png",
          "imageWidth": 250,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6fbd941-c396-48b3-84df-aa3ac4994b87"
      }
    }
  }
}
