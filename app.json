{
  "expo": {
    "name": "SolversHub",
    "slug": "solvershub-apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "solvershub",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solvershub.apk"
    },
    "android": {
      "package": "com.solvershub.apk",
      "adaptiveIcon": {
        "backgroundColor": "#172f6c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos como evidencia de gastos.",
          "cameraPermission": "La app usa la cámara para tomar evidencias de gastos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para registrar la trayectoria de la cartera."
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#172f6c",
          "image": "./assets/logo-transparente.png",
          "imageWidth": 250,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": false
        }
      ],
      "./plugins/solvershub-nsc"
    ],
    "owner": "devrochy",
    "extra": {
      "eas": {
        "projectId": "3e8fed2f-1720-4cd7-ab2f-01fac56167ed"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3e8fed2f-1720-4cd7-ab2f-01fac56167ed"
    }
  }
}
