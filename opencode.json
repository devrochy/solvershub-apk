{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "build",

  "instructions": [
    "AGENTS.md"
  ],

  "skills": {
    "paths": [".opencode/skill"]
  },

  "share": "manual",

  "compaction": {
    "auto": true,
    "tail_turns": 30
  },

  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },

  "references": {
    "backend": {
      "path": "../app-cobranza",
      "description": "Backend NestJS: contratos de endpoints, entidades y PRD. Fuente de verdad para verificar endpoints/campos (anti-alucinación)."
    },
    "docs": {
      "path": "~/Proyectos/solvershub/solvershub-docs",
      "description": "Plan SDD de SolversHub: HU, specs, decisiones y bitácora. Úsalo al trabajar una HU con la skill ejecutar-hu."
    }
  },

  "mcp": {
    "serena": {
      "type": "local",
      "command": ["/Users/roaguilar/.local/bin/serena", "start-mcp-server", "--context", "ide", "--project", "/Users/roaguilar/Projects/solvershub-apk"],
      "enabled": true,
      "environment": {}
    }
  },

  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "general": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  }
}
